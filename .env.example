# ── Firebase (configuration WEB publique — pas des secrets) ──
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Optionnel : active Firebase App Check (reCAPTCHA Enterprise)
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=

# URL publique du site (SEO, liens de connexion par e-mail)
NEXT_PUBLIC_SITE_URL=https://atelier-ecrivain.vercel.app

# ── Serveur uniquement (JAMAIS préfixé NEXT_PUBLIC_) ──
# Clé Gemini utilisée par le proxy /api/ai/*. Préférez un projet en offre
# payante : Google n'y utilise pas les contenus pour entraîner ses modèles.
GEMINI_API_KEY=

# Chaînes de modèles (ordre de préférence, séparés par des virgules)
AI_MODELS_TEXT=gemini-3.8-flash,gemini-3.7-flash,gemini-3.5-flash
AI_MODELS_FAST=gemini-3.1-flash-lite,gemini-3.5-flash-lite,gemini-3.8-flash
AI_MODELS_AUDIO=gemini-3.8-flash,gemini-3.5-flash
AI_MODELS_GROUNDED=gemini-3.8-flash,gemini-3.7-flash
AI_MODELS_IMAGE=gemini-3.1-flash-image,gemini-3.1-flash-lite-image

# Limites par utilisateur (requêtes IA)
AI_RATE_PER_MINUTE=12
AI_RATE_PER_DAY=300
AI_RATE_PER_DAY_ANONYMOUS=30
